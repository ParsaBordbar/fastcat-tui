//  https://github.com/m3tozz/FastCat
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
            "color": {
        "1": "38;5;22",
        "2": "38;5;28",
        "3": "38;5;34",
        "4": "38;5;71",
        "5": "38;5;114",
        "6": "38;5;234"
    }
    },
    "display": {
        "separator": " ",
        "key": {
            "width": 3
        }
    },
    "modules": [
        {
            "type": "os",
            "key": " ",
            "keyColor": "38;5;114",
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "38;5;114",
        },
        {
            "type": "packages",
            "key": " ",
            "keyColor": "38;5;77",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "38;5;77", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "38;5;71", 
        },
                        {
            "type": "de",
            "key": " ",
            "keyColor": "38;5;71"
        },
                {
            "type": "gpu",
            "key": " ",
            "format": "{3}",
            "keyColor": "38;5;40"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "38;5;40", 
        },
                {
            "type": "wmtheme",
            "key": " ",
            "keyColor": "38;5;34"
        },
        {
            "type": "cursor",
            "key": " ",
            "keyColor": "38;5;34", 
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "38;5;34", 
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "38;5;28", 
        },
        {
            "type": "datetime",
            "format": "{1}-{3}-{11}",
            "key": " ",
            "keyColor": "38;5;28", 
        },
                {
            "type": "memory",
            "key": " ",
            "keyColor": "38;5;22"
        },
                {
            "type": "monitor",
            "key": " ",
            "keyColor": "38;5;22",
        },
        ]
}

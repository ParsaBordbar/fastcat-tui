//   / ____/___ ______/ /_/ ____/___ _/ /_
//  / /_  / __ `/ ___/ __/ /   / __ `/ __/
// / __/ / /_/ (__  ) /_/ /___/ /_/ / /_  
///_/    \__,_/____/\__/\____/\__,_/\__/  
//  https://github.com/m3tozz/FastCat
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
            "color": {
        "1": "white",
        "2": "green",
        "3": "red",
        "4": "blue"
    }
    },
    "display": {
        "separator": " ",
        "key": {
            "width": 3
        }
    },
    "modules": [
        {
            "type": "break"
        },
        {
            "type": "break"
        },
        {
            "type": "break"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "blue",
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "blue",
        },
        {
            "type": "packages",
            "key": " ",
            "keyColor": "blue",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "blue", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "white", 
        },
                        {
            "type": "de",
            "key": " ",
            "keyColor": "white"
        },
                {
            "type": "gpu",
            "key": " ",
            "format": "{3}",
            "keyColor": "green"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "green", 
        },
                {
            "type": "wmtheme",
            "key": " ",
            "keyColor": "green"
        },
        {
            "type": "cursor",
            "key": " ",
            "keyColor": "green", 
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "green", 
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "red", 
        },
        {
            "type": "datetime",
            "format": "{1}-{3}-{11}",
            "key": " ",
            "keyColor": "red", 
        },
                {
            "type": "memory",
            "key": " ",
            "keyColor": "red"
        },
                {
            "type": "monitor",
            "key": " ",
            "keyColor": "red",
        },
        ]
}
